# ── Backend environment variables ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/sges2?schema=public"

# JWT secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_THIS_TO_A_64_BYTE_RANDOM_HEX_STRING"
JWT_EXPIRY="8h"

# Server
PORT=4000
NODE_ENV=development

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:5173

# Default admin password used during db:seed
# Change this BEFORE seeding in production
ADMIN_DEFAULT_PASSWORD="Admin@12345"

# Logging
LOG_LEVEL=info
